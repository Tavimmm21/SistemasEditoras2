<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemasEditoras.Views.LivroAlterar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.TabBarIsVisible="False"
    Title="Alterar Livro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Id" FontAttributes="Bold" />
            <Entry x:Name="IdEntry" IsReadOnly="True" />

            <Label Text="Título *" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry x:Name="NomeEntry" Placeholder="Título do livro" MaxLength="50" />

            <Label Text="Ano de publicação *" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry x:Name="AnoEntry" Placeholder="Ex.: 2020" Keyboard="Numeric" MaxLength="4" />

            <Label Text="ISBN *" FontAttributes="Bold" Margin="0,8,0,0" />
            <Entry x:Name="IsbnEntry" Placeholder="Somente números (até 14 dígitos)" Keyboard="Numeric" MaxLength="17" />

            <Label Text="Editora *" FontAttributes="Bold" Margin="0,8,0,0" />
            <Picker x:Name="EditoraPicker"
                    Title="Selecione a editora"
                    ItemDisplayBinding="{Binding Nome}" />

            <Label Text="Autor *" FontAttributes="Bold" Margin="0,8,0,0" />
            <Picker x:Name="AutorPicker"
                    Title="Selecione o autor"
                    ItemDisplayBinding="{Binding Nome}" />

            <Label Text="Observações" FontAttributes="Bold" Margin="0,8,0,0" />
            <Editor x:Name="ObservacoesEditor"
                    Placeholder="Observações (opcional)"
                    MaxLength="500"
                    HeightRequest="120" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button Grid.Column="0" Text="💾  Salvar" Clicked="OnSalvarClicked" />
                <Button Grid.Column="1"
                        Text="↩️  Voltar"
                        BackgroundColor="{StaticResource Gray500}"
                        Clicked="OnVoltarClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
