<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SistemasEditoras.Views.DadosDesenvolvedor"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dados do Desenvolvedor">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <!-- Icone ilustrativo -->
            <Image Source="icone_app"
                   HeightRequest="120"
                   WidthRequest="120"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0" />

            <!-- Nome do aplicativo -->
            <Label x:Name="AppLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Nome do desenvolvedor -->
            <Label x:Name="NomeLabel"
                   FontSize="18"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- RA do desenvolvedor -->
            <Label x:Name="RaLabel"
                   FontSize="18"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Data da avaliacao, em destaque (cor de fundo diferente dos demais textos) -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,12"
                    HorizontalOptions="Center">
                <Label x:Name="DataAvaliacaoLabel"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </Border>

            <Button Text="🏠  Home"
                    Margin="0,16,0,0"
                    Clicked="OnHomeClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
